# HealerDB Environment Configuration
# Copy this file to `.env` and configure your API keys and target database.

# LLM Reasoning Engine (Required)
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile

# Target Database Monitored by HealerDB (Default: local Docker Postgres)
TARGET_DB_HOST=localhost
TARGET_DB_PORT=5433
TARGET_DB_NAME=healerdb
TARGET_DB_USER=healerdb_user
TARGET_DB_PASSWORD=healerdb_pass

# Optional: Slack Notification & Interactive Approvals
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...
# SLACK_OPS_CHANNEL=healerdb-ops

# Optional Overrides (defaults are already configured in settings.py)
# APP_PORT=8001
# DRY_RUN=true
